# ── Banco de dados ────────────────────────────────────────────
# PostgreSQL local (Docker):
DATABASE_URL=postgresql://automais:automais@db:5432/automais

# Supabase (produção):
# DATABASE_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-aqui
JWT_EXPIRY_HOURS=24

# ── App ───────────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000

# ── CORS — domínio do frontend ────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── APIs externas opcionais ───────────────────────────────────
# Tokens ficam no banco (config_empresa), mas você pode
# definir defaults globais aqui se quiser:
# FIPE_API_TOKEN=
# PLACA_API_TOKEN=
